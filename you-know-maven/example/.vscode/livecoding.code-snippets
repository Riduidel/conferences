	"Add findclass-maven-plugin": {
		"prefix": "09_findclass",
		"description": "",
		"scope": "",
		"body": [
			"            <plugin>",
			"                <groupId>io.github.kerwin612</groupId>",
			"                <artifactId>findclass-maven-plugin</artifactId>",
			"                <version>0.0.2</version>",
			"                <executions>",
			"                    <execution>",
			"                        <id>Find main class</id>",
			"                        <goals>",
			"                            <goal>find</goal>",
			"                        </goals>",
			"                        <configuration>",
			"                            <methodKeyMatch>public static void .*\\.main\\(java.lang.String\\[\\]\\).*</methodKeyMatch>",
			"                            <firstFound>true</firstFound>",
			"                            <outputPropertyName>main.class</outputPropertyName>",
			"                        </configuration>",
			"                    </execution>",
			"                </executions>",
			"            </plugin>",
			""
		]
